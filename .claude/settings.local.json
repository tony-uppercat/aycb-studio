{
  "permissions": {
    "allow": [
      "Bash(/c/Users/upper/.claude/plugins/cache/claude-plugins-official/superpowers/5.0.7/skills/brainstorming/scripts/start-server.sh:*)",
      "Bash(python:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(node -e ':*)",
      "Bash(curl:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd frontend && npx tsc --noEmit --pretty 2>&1 | head -20",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
